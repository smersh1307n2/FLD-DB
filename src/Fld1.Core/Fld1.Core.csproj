<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <RootNamespace>Fld1.Core</RootNamespace>
    <AssemblyName>Fld1.Core</AssemblyName>
    <Version>0.1.0-alpha</Version>
    <Description>FLD1 Core primitives: Uuid7, HLC, ByteUtil, Canon, Hashes (xxHash64, CRC32C, Blake3).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blake3.Managed" Version="1.10.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>
</Project>
