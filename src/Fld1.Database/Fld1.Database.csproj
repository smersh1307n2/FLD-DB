<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <RootNamespace>Fld1</RootNamespace>
    <AssemblyName>Fld1.Database</AssemblyName>
    <Version>0.1.0-alpha</Version>
    <Description>FLD Database engine and overlay. Core, Manifest, Run and WAL sources are physically owned by this project; generic byte storage remains the separate Fld1.Storage assembly.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blake3.Managed" Version="1.10.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <ProjectReference Include="../Fld1.Storage/Fld1.Storage.csproj" />
  </ItemGroup>
</Project>
